#!/usr/bin/env sh
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_VERSION="8.14.3"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
GRADLE_HOME="$GRADLE_USER_HOME/manual-wrapper/gradle-$GRADLE_VERSION"

if [ ! -x "$GRADLE_HOME/bin/gradle" ]; then
  mkdir -p "$GRADLE_USER_HOME/manual-wrapper"
  ZIP_FILE="$GRADLE_USER_HOME/manual-wrapper/gradle-$GRADLE_VERSION-bin.zip"
  URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
  if command -v curl >/dev/null 2>&1; then
    curl -fL "$URL" -o "$ZIP_FILE"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$ZIP_FILE" "$URL"
  else
    echo "Gradle $GRADLE_VERSION is not installed and neither curl nor wget is available." >&2
    exit 1
  fi
  command -v unzip >/dev/null 2>&1 || {
    echo "The unzip command is required to install Gradle $GRADLE_VERSION." >&2
    exit 1
  }
  unzip -q -o "$ZIP_FILE" -d "$GRADLE_USER_HOME/manual-wrapper"
  rm -f "$ZIP_FILE"
fi
exec "$GRADLE_HOME/bin/gradle" -p "$APP_HOME" "$@"
